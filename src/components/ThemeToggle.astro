---
import { Icon } from '@astrojs/starlight/components';
---

<dygo-theme-toggle>
  <button type="button">
    <span class="to-light">
      <Icon name="sun" size="1.15rem" />
      <span class="sr-only">Switch to light mode</span>
    </span>
    <span class="to-dark">
      <Icon name="moon" size="1.15rem" />
      <span class="sr-only">Switch to dark mode</span>
    </span>
  </button>
</dygo-theme-toggle>

<style>
  button {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
  }
  button:hover {
    border-color: var(--color-rule);
    background: var(--color-surface);
    color: var(--color-ink);
  }
  button > span { display: flex; }
  :global([data-theme='dark']) .to-dark,
  :global([data-theme='light']) .to-light { display: none; }
</style>

<script>
  class DygoThemeToggle extends HTMLElement {
    private controller?: AbortController;

    connectedCallback() {
      this.controller = new AbortController();
      const { signal } = this.controller;
      const root = document.documentElement;
      const systemTheme = matchMedia('(prefers-color-scheme: light)');
      let followsSystem = true;
      try {
        const stored = localStorage.getItem('starlight-theme');
        followsSystem = stored !== 'light' && stored !== 'dark';
      } catch { /* Keep the toggle usable when storage is unavailable. */ }

      this.querySelector('button')?.addEventListener('click', () => {
        const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = theme;
        followsSystem = false;
        try {
          localStorage.setItem('starlight-theme', theme);
        } catch { /* The selected theme still applies to this page. */ }
      }, { signal });

      systemTheme.addEventListener('change', ({ matches }) => {
        if (followsSystem) root.dataset.theme = matches ? 'light' : 'dark';
      }, { signal });
    }

    disconnectedCallback() {
      this.controller?.abort();
    }
  }

  customElements.define('dygo-theme-toggle', DygoThemeToggle);
</script>
