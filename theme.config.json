      "label": "GitHub",
      "href": "https://github.com/hapyco/dygo",
      "external": true,
      "icon": "simple-icons:github"
    }
  ],
  "themeModeControl": "segmented-control",
  "docsNav": [
    {
      "label": "Start here",
      "items": [
