{
  "$schema": "https://prosefly.dev/schema/lotus.json",
  "name": "Dygo",
  "description": "The opinionated Go framework for serious business software.",
  "favicon": "/favicon.svg",
  "appearance": {
    "accent": "red",
    "gray": "stone",
    "defaultMode": "system",
